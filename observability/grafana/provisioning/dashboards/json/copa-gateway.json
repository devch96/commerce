          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"copa-gateway\",outcome=\"SERVER_ERROR\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"copa-gateway\"}[$__rate_interval])), 0.001)"
        }
