        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(kafka_consumer_fetch_manager_records_consumed_total[$__rate_interval]))",
          "legendFormat": "{{application}}"
        }
